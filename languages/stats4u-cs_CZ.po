# Stats4U - cs_CZ
# Liegt beim Plugin, damit die Uebersetzung auch ohne wordpress.org mitkommt.
msgid ""
msgstr ""
"Project-Id-Version: Stats4U 1.4.0\n"
"Report-Msgid-Bugs-To: https://www.stats4u.net/\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: cs_CZ\n"

msgid "This is a globe or map widget. The plugin shows image counters - pick an image design on stats4u.net."
msgstr "Toto je widget glóbu nebo mapy. Plugin zobrazuje obrázková počítadla – vyberte si na stats4u.net obrázkový design."

msgid "This is a link to a statistics page with a custom name. Paste the counter code instead - or just the counter number."
msgstr "Toto je odkaz na stránku statistik s vlastním názvem. Vložte místo něj kód počítadla – nebo jen číslo počítadla."

msgid "No Stats4U counter found in what you pasted. Paste the code from stats4u.net - or just the counter number."
msgstr "Ve vloženém textu nebylo nalezeno žádné počítadlo Stats4U. Vložte kód ze stats4u.net – nebo jen číslo počítadla."

msgid "Visitor counter"
msgstr "Počítadlo přístupů"

msgid "Stats4U counter"
msgstr "Počítadlo Stats4U"

msgid "Your visitor counter from stats4u.net."
msgstr "Vaše počítadlo přístupů ze stats4u.net."

msgid "Set up your counter first under Settings > Stats4U."
msgstr "Nejprve si nastavte počítadlo v Nastavení > Stats4U."

msgid "Stats4U"
msgstr "Stats4U"

msgid "Settings"
msgstr "Nastavení"

msgid "Your consent tool decides per service: add a service named \"%s\" there, in its statistics category - or enter the name you already use."
msgstr "Váš nástroj pro souhlasy rozhoduje podle služeb: přidejte v něm službu s názvem „%s“ do kategorie statistik – nebo zadejte název, který už používáte."

msgid "Enter the ID your consent tool uses for statistics - its settings show it. Until then the counter does not load."
msgstr "Zadejte ID, které váš nástroj pro souhlasy používá pro statistiky – najdete ho v jeho nastavení. Do té doby se počítadlo nenačte."

msgid "Uses the category \"%s\" of your consent tool. Change it only if yours is called differently."
msgstr "Používá kategorii „%s“ vašeho nástroje pro souhlasy. Změňte ji jen tehdy, pokud se u vás jmenuje jinak."

msgid "Stats4U Visitor Counter"
msgstr "Stats4U Počítadlo přístupů"

msgid "%s needs the ID it uses for statistics (see \"Category or service\" below). Until you enter it, the counter does not load."
msgstr "%s potřebuje ID, které používá pro statistiky (viz „Kategorie nebo služba“ níže). Dokud ho nezadáte, počítadlo se nenačte."

msgid "Received from stats4u.net: counter %1$s, design %2$s. Click \"Save Changes\" to use it."
msgstr "Přijato ze stats4u.net: počítadlo %1$s, design %2$s. Pro použití klikněte na „Uložit změny“."

msgid "Paste the code you got on stats4u.net below - or create a free counter there first. No sign-up."
msgstr "Níže vložte kód, který jste získali na stats4u.net – nebo si tam nejprve vytvořte počítadlo zdarma. Bez registrace."

msgid "Your counter"
msgstr "Vaše počítadlo"

msgid "Counter"
msgstr "Počítadlo"

msgid "Counter %1$s, design %2$s"
msgstr "Počítadlo %1$s, design %2$s"

msgid "Preview - not counted."
msgstr "Náhled – nezapočítává se."

msgid "Code from stats4u.net"
msgstr "Kód ze stats4u.net"

msgid "Paste your code"
msgstr "Vložte svůj kód"

msgid "Use a different counter or code"
msgstr "Použít jiné počítadlo nebo kód"

msgid "Paste the HTML, BBCode or image address from stats4u.net - or just the counter number. Design, colors, size and everything else you set there come along."
msgstr "Vložte HTML, BBCode nebo adresu obrázku ze stats4u.net – nebo jen číslo počítadla. Design, barvy, velikost a vše ostatní, co jste tam nastavili, se převezme."

msgid "Create a free counter on stats4u.net"
msgstr "Vytvořit počítadlo zdarma na stats4u.net"

msgid "At the end, a button brings the code back here."
msgstr "Na konci vám tlačítko vrátí kód sem."

msgid "Appearance"
msgstr "Vzhled"

msgid "Size"
msgstr "Velikost"

msgid "Sharp at any size for the modern designs. The classic pixel designs keep their original size."
msgstr "Moderní designy jsou ostré v každé velikosti. Klasické pixelové designy si ponechají původní velikost."

msgid "Language of the counter"
msgstr "Jazyk počítadla"

msgid "as set on stats4u.net"
msgstr "podle nastavení na stats4u.net"

msgid "the language of each page"
msgstr "jazyk dané stránky"

msgid "Dark mode"
msgstr "Tmavý režim"

msgid "follow the device"
msgstr "podle zařízení"

msgid "always light"
msgstr "vždy světlý"

msgid "always dark"
msgstr "vždy tmavý"

msgid "Count"
msgstr "Počítat"

msgid "every page view"
msgstr "každé zobrazení stránky"

msgid "unique visitors"
msgstr "unikátní návštěvníky"

msgid "Link"
msgstr "Odkaz"

msgid "link the counter to its public statistics page on stats4u.net"
msgstr "propojit počítadlo s jeho veřejnou stránkou statistik na stats4u.net"

msgid "Off by default. Visitors who click the counter then see your statistics."
msgstr "Ve výchozím stavu vypnuto. Návštěvníci, kteří na počítadlo kliknou, pak uvidí vaše statistiky."

msgid "Placement"
msgstr "Umístění"

msgid "Where to show it"
msgstr "Kde zobrazit"

msgid "below your theme's footer (recommended)"
msgstr "pod patičkou šablony (doporučeno)"

msgid "inside your theme's footer, at its end"
msgstr "v patičce šablony, na jejím konci"

msgid "at the very end of the page"
msgstr "úplně na konci stránky"

msgid "below the content of posts and pages"
msgstr "pod obsahem příspěvků a stránek"

msgid "fixed in the bottom right corner"
msgstr "pevně v pravém dolním rohu"

msgid "fixed in the bottom left corner"
msgstr "pevně v levém dolním rohu"

msgid "nowhere automatically - I place it myself"
msgstr "nikde automaticky – umístím ho ručně"

msgid "To place it yourself, use the block \"Stats4U counter\" or the shortcode [stats4u] - for example in a footer widget."
msgstr "Pro vlastní umístění použijte blok „Počítadlo Stats4U“ nebo shortcode [stats4u] – například ve widgetu v patičce."

msgid "Alignment"
msgstr "Zarovnání"

msgid "left"
msgstr "vlevo"

msgid "center"
msgstr "na střed"

msgid "right"
msgstr "vpravo"

msgid "On which pages"
msgstr "Na kterých stránkách"

msgid "on all pages"
msgstr "na všech stránkách"

msgid "only on the front page"
msgstr "jen na úvodní stránce"

msgid "only on single posts and pages"
msgstr "jen u jednotlivých příspěvků a stránek"

msgid "Consent"
msgstr "Souhlas"

msgid "Load the counter"
msgstr "Načíst počítadlo"

msgid "right away - I use no consent tool"
msgstr "hned – nepoužívám nástroj pro souhlasy"

msgid "Found on this site"
msgstr "Nalezeno na tomto webu"

msgid "after consent in %s"
msgstr "po souhlasu v %s"

msgid "Consent tools"
msgstr "Nástroje pro souhlasy"

msgid "after consent in another tool - enter its attributes"
msgstr "po souhlasu v jiném nástroji – zadejte jeho atributy"

msgid "With a consent tool, visitors who decline are not counted - your numbers will be lower."
msgstr "S nástrojem pro souhlasy se návštěvníci, kteří odmítnou, nezapočítají – vaše čísla budou nižší."

msgid "Category or service"
msgstr "Kategorie nebo služba"

msgid "Leave empty for the usual one of your tool. If your tool works with named services, enter the name you gave Stats4U there."
msgstr "Nechte prázdné pro obvyklou kategorii vašeho nástroje. Pokud váš nástroj pracuje s pojmenovanými službami, zadejte název, který jste tam dali Stats4U."

msgid "Attributes"
msgstr "Atributy"

msgid "What your consent tool wants on a script it should only run after consent. Allowed: type, class and data-* attributes."
msgstr "Co váš nástroj pro souhlasy vyžaduje u skriptu, který se má spustit až po souhlasu. Povoleno: atributy type, class a data-*."

msgid "A paragraph for your privacy policy is at %s."
msgstr "Odstavec pro vaše zásady ochrany osobních údajů najdete na %s."

msgid "Puts a Stats4U visitor counter on your site. Paste the code from stats4u.net, choose where it appears and, if you use a consent banner, let it decide when the counter loads."
msgstr "Umístí na váš web počítadlo přístupů Stats4U. Vložte kód ze stats4u.net, zvolte, kde se má zobrazit, a pokud používáte cookie lištu, nechte ji rozhodnout, kdy se počítadlo načte."

msgid "Your code"
msgstr "Váš kód"

#. translators: %s: a line of PHP code
#, php-format
msgid "In a theme template (PHP): %s"
msgstr "V souboru šablony (PHP): %s"

msgid "Feedback"
msgstr "Zpětná vazba"

msgid "Missing something, found a bug, or have an idea? Write to us - every message is read."
msgstr "Něco vám chybí, našli jste chybu, nebo máte nápad? Napište nám – čteme každou zprávu."

msgid "Your message"
msgstr "Vaše zpráva"

msgid "Email for an answer (optional)"
msgstr "E-mail pro odpověď (nepovinné)"

msgid "Also send my site address and counter number"
msgstr "Poslat také adresu mého webu a číslo počítadla"

msgid "Send feedback"
msgstr "Odeslat"

msgid "Thank you - your message has arrived."
msgstr "Děkujeme – vaše zpráva dorazila."

msgid "Please write a little more - at least a few words."
msgstr "Napište prosím trochu víc – alespoň pár slov."

msgid "This email address does not look right."
msgstr "Tato e-mailová adresa nevypadá správně."

msgid "Too many messages from here - please try again in an hour."
msgstr "Odsud přišlo příliš mnoho zpráv – zkuste to prosím znovu za hodinu."

msgid "stats4u.net could not be reached. Please try again later."
msgstr "stats4u.net se nepodařilo zastihnout. Zkuste to prosím později."

#. translators: %s: link "Privacy policy" to stats4u.net
#, php-format
msgid "Your browser sends the message to stats4u.net, together with the plugin version and the language of this page. %s"
msgstr "Váš prohlížeč odešle zprávu na stats4u.net spolu s verzí pluginu a jazykem této stránky. %s"

msgid "Privacy policy"
msgstr "Zásady ochrany osobních údajů"

msgid "Free hit counters and visitor stats for websites"
msgstr "Počítadla přístupů zdarma a statistiky návštěvnosti webu"

msgid "Simple, lightweight and secure analytics."
msgstr "Jednoduchá, lehká a bezpečná analytika."

msgid "Restart wizard"
msgstr "Spustit průvodce znovu"

msgid "Custom configuration"
msgstr "Vlastní nastavení"

msgid "Done"
msgstr "Hotovo"

msgid "Settings sections"
msgstr "Části nastavení"

#. translators: 1: counter number, 2: design number
#, php-format
msgid "Received from stats4u.net: counter %1$s, design %2$s. Continue with \"Next\"."
msgstr "Přijato ze stats4u.net: počítadlo %1$s, design %2$s. Pokračujte tlačítkem „Další“."

msgid "Request a new counter number"
msgstr "Vyžádat nové číslo počítadla"

msgid "Back"
msgstr "Zpět"

msgid "Next"
msgstr "Další"

msgid "Save and finish"
msgstr "Uložit a dokončit"

msgid "Save to put the counter on your site. You can change everything later - or run this wizard again."
msgstr "Uložením umístíte počítadlo na svůj web. Vše můžete později změnit – nebo tohoto průvodce spustit znovu."

msgid "How do you want to set up your counter?"
msgstr "Jak chcete počítadlo nastavit?"

msgid "Recommended"
msgstr "Doporučeno"

msgid "Wizard"
msgstr "Průvodce"

msgid "Step by step, with a live preview - about two minutes."
msgstr "Krok za krokem, s živým náhledem – zhruba dvě minuty."

msgid "Start the wizard"
msgstr "Spustit průvodce"

msgid "All settings on one page, sorted in a menu."
msgstr "Všechna nastavení na jedné stránce, seřazená v nabídce."

msgid "Open the settings"
msgstr "Otevřít nastavení"

#. translators: 1: number of the current step, 2: number of steps
#, php-format
msgid "Step %1$d of %2$d"
msgstr "Krok %1$d z %2$d"

msgid "Choose or create a counter first."
msgstr "Nejdříve vyberte nebo vytvořte počítadlo."

#. translators: %s: the new counter number
#, php-format
msgid "New counter number %s - it is used as soon as you save."
msgstr "Nové číslo počítadla %s – použije se, jakmile uložíte."

msgid "Too many new numbers from here - please try again in an hour."
msgstr "Odsud bylo vyžádáno příliš mnoho nových čísel – zkuste to prosím znovu za hodinu."
