msgid "A paragraph for your privacy policy is at %s."
msgstr "Odstavec pro vaše zásady ochrany osobních údajů najdete na %s."

msgid "Counter number"
msgstr "Číslo počítadla"

msgid "Dark mode"
msgstr "Tmavý režim"

msgid "Design"
msgstr "Design"

msgid "Otherwise put the shortcode [stats4u] wherever you like."
msgstr "Případně vložte shortcode [stats4u] na libovolné místo."

msgid "Palette"
msgstr "Paleta"

msgid "Preview"
msgstr "Náhled"

msgid "Puts a Stats4U counter on your site - as the shortcode [stats4u] or automatically in the footer. One image, no script, no cookie."
msgstr "Vloží na váš web počítadlo Stats4U – jako shortcode [stats4u] nebo automaticky do zápatí. Jeden obrázek, žádný skript, žádné cookies."

msgid "Shape"
msgstr "Tvar"

msgid "Shape and palette only apply to design 950. Pick them in the creator at %s and copy the names out of the address - there are far too many to list here, and a list here would go stale."
msgstr "Tvar a paleta platí jen pro design 950. Zvolte je v průvodci na %s a názvy zkopírujte z adresy – je jich příliš mnoho na to, aby se tu vypisovaly, a seznam by tu stejně brzy zastaral."

msgid "Stats4U Visitor Counter"
msgstr "Stats4U Počítadlo přístupů"

msgid "The number from the gallery. 950 is the adjustable counter."
msgstr "Číslo z galerie. 950 je nastavitelné počítadlo."

msgid "Visitor counter"
msgstr "Počítadlo přístupů"

msgid "Where to show it"
msgstr "Kde zobrazit"

msgid "You need a counter number first. Get one at %s - no sign-up."
msgstr "Nejdřív potřebujete číslo počítadla. Získáte ho na %s – bez registrace."

msgid "always dark"
msgstr "vždy tmavý"

msgid "always light"
msgstr "vždy světlý"

msgid "follow the device"
msgstr "podle zařízení"

msgid "show automatically in the footer"
msgstr "zobrazit automaticky v zápatí"

msgid "Link"
msgstr "Odkaz"

msgid "link the counter to its public statistics page on stats4u.net"
msgstr "propojit počítadlo s jeho veřejnou stránkou statistik na stats4u.net"

msgid "Off by default. Visitors who click the counter then see your statistics."
msgstr "Ve výchozím stavu vypnuto. Návštěvníci, kteří na počítadlo kliknou, pak uvidí vaše statistiky."
