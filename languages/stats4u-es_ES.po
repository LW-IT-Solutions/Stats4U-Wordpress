"Language: es_ES\n"

msgid "A paragraph for your privacy policy is at %s."
msgstr "Tienes un párrafo para tu política de privacidad en %s."

msgid "Counter number"
msgstr "Número de contador"

msgid "Dark mode"
msgstr "Modo oscuro"

msgid "Design"
msgstr "Diseño"

msgid "Otherwise put the shortcode [stats4u] wherever you like."
msgstr "Si no, coloca el shortcode [stats4u] donde quieras."

msgid "Palette"
msgstr "Paleta"

msgid "Preview"
msgstr "Vista previa"

msgid "Puts a Stats4U counter on your site - as the shortcode [stats4u] or automatically in the footer. One image, no script, no cookie."
msgstr "Coloca un contador Stats4U en tu sitio: con el shortcode [stats4u] o automáticamente en el pie de página. Una imagen, sin script, sin cookies."

msgid "Shape"
msgstr "Forma"

msgid "Shape and palette only apply to design 950. Pick them in the creator at %s and copy the names out of the address - there are far too many to list here, and a list here would go stale."
msgstr "La forma y la paleta solo se aplican al diseño 950. Elígelas en el asistente de %s y copia los nombres de la dirección: son demasiados para enumerarlos aquí, y una lista aquí se quedaría anticuada."

msgid "Stats4U Visitor Counter"
msgstr "Stats4U Contador de visitas"

msgid "The number from the gallery. 950 is the adjustable counter."
msgstr "El número de la galería. 950 es el contador configurable."

msgid "Visitor counter"
msgstr "Contador de visitas"

msgid "Where to show it"
msgstr "Dónde mostrarlo"

msgid "You need a counter number first. Get one at %s - no sign-up."
msgstr "Primero necesitas un número de contador. Consíguelo en %s, sin registro."

msgid "always dark"
msgstr "siempre oscuro"

msgid "always light"
msgstr "siempre claro"

msgid "follow the device"
msgstr "según el dispositivo"

msgid "show automatically in the footer"
msgstr "mostrar automáticamente en el pie de página"

msgid "Link"
msgstr "Enlace"

msgid "link the counter to its public statistics page on stats4u.net"
msgstr "enlazar el contador con su página pública de estadísticas en stats4u.net"

msgid "Off by default. Visitors who click the counter then see your statistics."
msgstr "Desactivado por defecto. Quien haga clic en el contador verá tus estadísticas."
