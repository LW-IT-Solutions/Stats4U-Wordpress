"Language: ru_RU\n"

msgid "A paragraph for your privacy policy is at %s."
msgstr "Абзац для вашей политики конфиденциальности есть на %s."

msgid "Counter number"
msgstr "Номер счётчика"

msgid "Dark mode"
msgstr "Тёмный режим"

msgid "Design"
msgstr "Дизайн"

msgid "Otherwise put the shortcode [stats4u] wherever you like."
msgstr "Или вставьте шорткод [stats4u] в любое место."

msgid "Palette"
msgstr "Палитра"

msgid "Preview"
msgstr "Предпросмотр"

msgid "Puts a Stats4U counter on your site - as the shortcode [stats4u] or automatically in the footer. One image, no script, no cookie."
msgstr "Добавляет счётчик Stats4U на ваш сайт — шорткодом [stats4u] или автоматически в подвале. Одна картинка, без скриптов, без куки."

msgid "Shape"
msgstr "Форма"

msgid "Shape and palette only apply to design 950. Pick them in the creator at %s and copy the names out of the address - there are far too many to list here, and a list here would go stale."
msgstr "Форма и палитра действуют только для дизайна 950. Выберите их в мастере на %s и скопируйте названия из адреса — их слишком много, чтобы перечислять здесь, да и такой список быстро устарел бы."

msgid "Stats4U Visitor Counter"
msgstr "Stats4U Счётчик посещений"

msgid "The number from the gallery. 950 is the adjustable counter."
msgstr "Номер из галереи. 950 — настраиваемый счётчик."

msgid "Visitor counter"
msgstr "Счётчик посещений"

msgid "Where to show it"
msgstr "Где показывать"

msgid "You need a counter number first. Get one at %s - no sign-up."
msgstr "Сначала нужен номер счётчика. Получите его на %s — без регистрации."

msgid "always dark"
msgstr "всегда тёмный"

msgid "always light"
msgstr "всегда светлый"

msgid "follow the device"
msgstr "по настройке устройства"

msgid "show automatically in the footer"
msgstr "показывать автоматически в подвале"

msgid "Link"
msgstr "Ссылка"

msgid "link the counter to its public statistics page on stats4u.net"
msgstr "сделать счётчик ссылкой на его публичную страницу статистики на stats4u.net"

msgid "Off by default. Visitors who click the counter then see your statistics."
msgstr "По умолчанию выключено. Посетители, нажавшие на счётчик, увидят вашу статистику."
