# Stats4U - ru_RU
# Liegt beim Plugin, damit die Uebersetzung auch ohne wordpress.org mitkommt.
msgid ""
msgstr ""
"Project-Id-Version: Stats4U 1.4.0\n"
"Report-Msgid-Bugs-To: https://www.stats4u.net/\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ru_RU\n"

msgid "This is a globe or map widget. The plugin shows image counters - pick an image design on stats4u.net."
msgstr "Это виджет глобуса или карты. Плагин показывает графические счётчики — выберите графический дизайн на stats4u.net."

msgid "This is a link to a statistics page with a custom name. Paste the counter code instead - or just the counter number."
msgstr "Это ссылка на страницу статистики с собственным именем. Вставьте вместо неё код счётчика — или только номер счётчика."

msgid "No Stats4U counter found in what you pasted. Paste the code from stats4u.net - or just the counter number."
msgstr "Во вставленном тексте не найден счётчик Stats4U. Вставьте код с сайта stats4u.net — или только номер счётчика."

msgid "Visitor counter"
msgstr "Счётчик посещений"

msgid "Stats4U counter"
msgstr "Счётчик Stats4U"

msgid "Your visitor counter from stats4u.net."
msgstr "Ваш счётчик посещений с сайта stats4u.net."

msgid "Set up your counter first under Settings > Stats4U."
msgstr "Сначала настройте счётчик в разделе Настройки > Stats4U."

msgid "Stats4U"
msgstr "Stats4U"

msgid "Settings"
msgstr "Настройки"

msgid "Your consent tool decides per service: add a service named \"%s\" there, in its statistics category - or enter the name you already use."
msgstr "Ваш инструмент согласия решает для каждого сервиса отдельно: добавьте в нём сервис с именем «%s» в категорию статистики — или укажите имя, которое уже используете."

msgid "Enter the ID your consent tool uses for statistics - its settings show it. Until then the counter does not load."
msgstr "Укажите ID, который ваш инструмент согласия использует для статистики, — он есть в его настройках. До этого счётчик не загружается."

msgid "Uses the category \"%s\" of your consent tool. Change it only if yours is called differently."
msgstr "Используется категория «%s» вашего инструмента согласия. Меняйте её, только если у вас она называется иначе."

msgid "Stats4U Visitor Counter"
msgstr "Stats4U Счётчик посещений"

msgid "%s needs the ID it uses for statistics (see \"Category or service\" below). Until you enter it, the counter does not load."
msgstr "%s нужен ID, который он использует для статистики (см. «Категория или сервис» ниже). Пока вы его не укажете, счётчик не загружается."

msgid "Received from stats4u.net: counter %1$s, design %2$s. Click \"Save Changes\" to use it."
msgstr "Получено с stats4u.net: счётчик %1$s, дизайн %2$s. Нажмите «Сохранить изменения», чтобы его использовать."

msgid "Paste the code you got on stats4u.net below - or create a free counter there first. No sign-up."
msgstr "Вставьте ниже код, полученный на stats4u.net, — или сначала создайте там бесплатный счётчик. Без регистрации."

msgid "Your counter"
msgstr "Ваш счётчик"

msgid "Counter"
msgstr "Счётчик"

msgid "Counter %1$s, design %2$s"
msgstr "Счётчик %1$s, дизайн %2$s"

msgid "Preview - not counted."
msgstr "Предпросмотр — не засчитывается."

msgid "Code from stats4u.net"
msgstr "Код с stats4u.net"

msgid "Paste your code"
msgstr "Вставьте ваш код"

msgid "Use a different counter or code"
msgstr "Использовать другой счётчик или код"

msgid "Paste the HTML, BBCode or image address from stats4u.net - or just the counter number. Design, colors, size and everything else you set there come along."
msgstr "Вставьте HTML, BBCode или адрес изображения с stats4u.net — или только номер счётчика. Дизайн, цвета, размер и всё остальное, что вы там настроили, перенесутся."

msgid "Create a free counter on stats4u.net"
msgstr "Создать бесплатный счётчик на stats4u.net"

msgid "At the end, a button brings the code back here."
msgstr "В конце кнопка вернёт код сюда."

msgid "Appearance"
msgstr "Внешний вид"

msgid "Size"
msgstr "Размер"

msgid "Sharp at any size for the modern designs. The classic pixel designs keep their original size."
msgstr "Современные дизайны остаются чёткими при любом размере. Классические пиксельные дизайны сохраняют исходный размер."

msgid "Language of the counter"
msgstr "Язык счётчика"

msgid "as set on stats4u.net"
msgstr "как задано на stats4u.net"

msgid "the language of each page"
msgstr "язык каждой страницы"

msgid "Dark mode"
msgstr "Тёмный режим"

msgid "follow the device"
msgstr "по настройке устройства"

msgid "always light"
msgstr "всегда светлый"

msgid "always dark"
msgstr "всегда тёмный"

msgid "Count"
msgstr "Считать"

msgid "every page view"
msgstr "каждый просмотр страницы"

msgid "unique visitors"
msgstr "уникальных посетителей"

msgid "Link"
msgstr "Ссылка"

msgid "link the counter to its public statistics page on stats4u.net"
msgstr "сделать счётчик ссылкой на его публичную страницу статистики на stats4u.net"

msgid "Off by default. Visitors who click the counter then see your statistics."
msgstr "По умолчанию выключено. Посетители, нажавшие на счётчик, увидят вашу статистику."

msgid "Placement"
msgstr "Размещение"

msgid "Where to show it"
msgstr "Где показывать"

msgid "below your theme's footer (recommended)"
msgstr "под подвалом темы (рекомендуется)"

msgid "inside your theme's footer, at its end"
msgstr "в подвале темы, в его конце"

msgid "at the very end of the page"
msgstr "в самом конце страницы"

msgid "below the content of posts and pages"
msgstr "под содержимым записей и страниц"

msgid "fixed in the bottom right corner"
msgstr "закреплённым в правом нижнем углу"

msgid "fixed in the bottom left corner"
msgstr "закреплённым в левом нижнем углу"

msgid "nowhere automatically - I place it myself"
msgstr "нигде автоматически — размещу вручную"

msgid "To place it yourself, use the block \"Stats4U counter\" or the shortcode [stats4u] - for example in a footer widget."
msgstr "Чтобы разместить его самостоятельно, используйте блок «Счётчик Stats4U» или шорткод [stats4u] — например, в виджете в подвале."

msgid "Alignment"
msgstr "Выравнивание"

msgid "left"
msgstr "по левому краю"

msgid "center"
msgstr "по центру"

msgid "right"
msgstr "по правому краю"

msgid "On which pages"
msgstr "На каких страницах"

msgid "on all pages"
msgstr "на всех страницах"

msgid "only on the front page"
msgstr "только на главной странице"

msgid "only on single posts and pages"
msgstr "только на отдельных записях и страницах"

msgid "Consent"
msgstr "Согласие"

msgid "Load the counter"
msgstr "Загружать счётчик"

msgid "right away - I use no consent tool"
msgstr "сразу — я не использую инструмент согласия"

msgid "Found on this site"
msgstr "Найдено на этом сайте"

msgid "after consent in %s"
msgstr "после согласия в %s"

msgid "Consent tools"
msgstr "Инструменты согласия"

msgid "after consent in another tool - enter its attributes"
msgstr "после согласия в другом инструменте — укажите его атрибуты"

msgid "With a consent tool, visitors who decline are not counted - your numbers will be lower."
msgstr "С инструментом согласия посетители, которые отказываются, не учитываются — ваши цифры будут ниже."

msgid "Category or service"
msgstr "Категория или сервис"

msgid "Leave empty for the usual one of your tool. If your tool works with named services, enter the name you gave Stats4U there."
msgstr "Оставьте пустым, чтобы использовать обычную категорию вашего инструмента. Если ваш инструмент работает с именованными сервисами, укажите имя, которое вы дали там Stats4U."

msgid "Attributes"
msgstr "Атрибуты"

msgid "What your consent tool wants on a script it should only run after consent. Allowed: type, class and data-* attributes."
msgstr "Что ваш инструмент согласия требует от скрипта, который должен запускаться только после согласия. Разрешены: атрибуты type, class и data-*."

msgid "A paragraph for your privacy policy is at %s."
msgstr "Абзац для вашей политики конфиденциальности есть на %s."

msgid "Puts a Stats4U visitor counter on your site. Paste the code from stats4u.net, choose where it appears and, if you use a consent banner, let it decide when the counter loads."
msgstr "Добавляет на ваш сайт счётчик посещений Stats4U. Вставьте код с stats4u.net, выберите, где он будет показываться, и, если вы используете баннер согласия, позвольте ему решать, когда загружать счётчик."

msgid "Your code"
msgstr "Ваш код"

#. translators: %s: a line of PHP code
#, php-format
msgid "In a theme template (PHP): %s"
msgstr "В шаблоне темы (PHP): %s"

msgid "Feedback"
msgstr "Обратная связь"

msgid "Missing something, found a bug, or have an idea? Write to us - every message is read."
msgstr "Чего-то не хватает, нашли ошибку или есть идея? Напишите нам – мы читаем каждое сообщение."

msgid "Your message"
msgstr "Ваше сообщение"

msgid "Email for an answer (optional)"
msgstr "E-mail для ответа (необязательно)"

msgid "Also send my site address and counter number"
msgstr "Также отправить адрес моего сайта и номер счётчика"

msgid "Send feedback"
msgstr "Отправить"

msgid "Thank you - your message has arrived."
msgstr "Спасибо – ваше сообщение получено."

msgid "Please write a little more - at least a few words."
msgstr "Пожалуйста, напишите чуть подробнее – хотя бы несколько слов."

msgid "This email address does not look right."
msgstr "Этот адрес электронной почты выглядит неверным."

msgid "Too many messages from here - please try again in an hour."
msgstr "Слишком много сообщений отсюда – попробуйте снова через час."

msgid "stats4u.net could not be reached. Please try again later."
msgstr "Не удалось связаться с stats4u.net. Попробуйте позже."

#. translators: %s: link "Privacy policy" to stats4u.net
#, php-format
msgid "Your browser sends the message to stats4u.net, together with the plugin version and the language of this page. %s"
msgstr "Ваш браузер отправит сообщение на stats4u.net вместе с версией плагина и языком этой страницы. %s"

msgid "Privacy policy"
msgstr "Политика конфиденциальности"
