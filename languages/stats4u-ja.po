# Stats4U - ja
# Liegt beim Plugin, damit die Uebersetzung auch ohne wordpress.org mitkommt.
msgid ""
msgstr ""
"Project-Id-Version: Stats4U 1.3.0\n"
"Report-Msgid-Bugs-To: https://www.stats4u.net/\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ja\n"

msgid "A paragraph for your privacy policy is at %s."
msgstr "プライバシーポリシーに載せる文例は %s にあります。"

msgid "Counter number"
msgstr "カウンター番号"

msgid "Dark mode"
msgstr "ダークモード"

msgid "Design"
msgstr "デザイン"

msgid "Otherwise put the shortcode [stats4u] wherever you like."
msgstr "または、ショートコード [stats4u] を好きな場所に入れてください。"

msgid "Palette"
msgstr "配色"

msgid "Preview"
msgstr "プレビュー"

msgid "Puts a Stats4U counter on your site - as the shortcode [stats4u] or automatically in the footer. One image, no script, no cookie."
msgstr "サイトに Stats4U のカウンターを設置します。ショートコード [stats4u] で入れるか、フッターに自動で表示します。画像ひとつだけで、スクリプトもクッキーも使いません。"

msgid "Shape"
msgstr "形"

msgid "Shape and palette only apply to design 950. Pick them in the creator at %s and copy the names out of the address - there are far too many to list here, and a list here would go stale."
msgstr "形と配色はデザイン 950 にだけ適用されます。%s の作成画面で選び、アドレスから名前を書き写してください。数が多すぎてここには並べきれませんし、ここに一覧を置いてもすぐ古くなります。"

msgid "Stats4U Visitor Counter"
msgstr "Stats4U アクセスカウンター"

msgid "The number from the gallery. 950 is the adjustable counter."
msgstr "ギャラリーの番号です。950 は細かく設定できるカウンターです。"

msgid "Visitor counter"
msgstr "アクセスカウンター"

msgid "Where to show it"
msgstr "表示する場所"

msgid "You need a counter number first. Get one at %s - no sign-up."
msgstr "まずカウンター番号が必要です。%s で取得できます。登録は不要です。"

msgid "always dark"
msgstr "常にダーク"

msgid "always light"
msgstr "常にライト"

msgid "follow the device"
msgstr "端末に合わせる"

msgid "show automatically in the footer"
msgstr "フッターに自動で表示する"

msgid "Link"
msgstr "リンク"

msgid "link the counter to its public statistics page on stats4u.net"
msgstr "カウンターを stats4u.net の公開統計ページにリンクする"

msgid "Off by default. Visitors who click the counter then see your statistics."
msgstr "初期状態ではオフです。オンにすると、カウンターをクリックした訪問者があなたの統計を見られます。"
