# Stats4U - ko_KR
# Liegt beim Plugin, damit die Uebersetzung auch ohne wordpress.org mitkommt.
msgid ""
msgstr ""
"Project-Id-Version: Stats4U 1.4.0\n"
"Report-Msgid-Bugs-To: https://www.stats4u.net/\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ko_KR\n"

msgid "This is a globe or map widget. The plugin shows image counters - pick an image design on stats4u.net."
msgstr "지구본 또는 지도 위젯입니다. 이 플러그인은 이미지 카운터를 표시합니다. stats4u.net에서 이미지 디자인을 선택하세요."

msgid "This is a link to a statistics page with a custom name. Paste the counter code instead - or just the counter number."
msgstr "사용자 지정 이름이 붙은 통계 페이지 링크입니다. 대신 카운터 코드를 붙여넣거나 카운터 번호만 입력하세요."

msgid "No Stats4U counter found in what you pasted. Paste the code from stats4u.net - or just the counter number."
msgstr "붙여넣은 내용에서 Stats4U 카운터를 찾을 수 없습니다. stats4u.net의 코드를 붙여넣거나 카운터 번호만 입력하세요."

msgid "Visitor counter"
msgstr "방문자 카운터"

msgid "Stats4U counter"
msgstr "Stats4U 카운터"

msgid "Your visitor counter from stats4u.net."
msgstr "stats4u.net의 방문자 카운터입니다."

msgid "Set up your counter first under Settings > Stats4U."
msgstr "먼저 “설정 > Stats4U”에서 카운터를 설정하세요."

msgid "Stats4U"
msgstr "Stats4U"

msgid "Settings"
msgstr "설정"

msgid "Your consent tool decides per service: add a service named \"%s\" there, in its statistics category - or enter the name you already use."
msgstr "동의 관리 도구는 서비스별로 결정합니다. 도구의 통계 카테고리에 “%s”라는 이름의 서비스를 추가하거나 이미 사용 중인 이름을 입력하세요."

msgid "Enter the ID your consent tool uses for statistics - its settings show it. Until then the counter does not load."
msgstr "동의 관리 도구가 통계에 사용하는 ID를 입력하세요. 도구 설정에서 확인할 수 있습니다. 입력하기 전에는 카운터가 로드되지 않습니다."

msgid "Uses the category \"%s\" of your consent tool. Change it only if yours is called differently."
msgstr "동의 관리 도구의 “%s” 카테고리를 사용합니다. 도구에서 이름이 다른 경우에만 변경하세요."

msgid "Stats4U Visitor Counter"
msgstr "Stats4U 방문자 카운터"

msgid "%s needs the ID it uses for statistics (see \"Category or service\" below). Until you enter it, the counter does not load."
msgstr "%s에는 통계에 사용하는 ID가 필요합니다(아래 “카테고리 또는 서비스” 참조). 입력하기 전에는 카운터가 로드되지 않습니다."

msgid "Received from stats4u.net: counter %1$s, design %2$s. Click \"Save Changes\" to use it."
msgstr "stats4u.net에서 받았습니다: 카운터 %1$s, 디자인 %2$s. 사용하려면 “변경 사항 저장”을 클릭하세요."

msgid "Paste the code you got on stats4u.net below - or create a free counter there first. No sign-up."
msgstr "stats4u.net에서 받은 코드를 아래에 붙여넣거나, 먼저 그곳에서 무료 카운터를 만드세요. 가입할 필요가 없습니다."

msgid "Your counter"
msgstr "내 카운터"

msgid "Counter"
msgstr "카운터"

msgid "Counter %1$s, design %2$s"
msgstr "카운터 %1$s, 디자인 %2$s"

msgid "Preview - not counted."
msgstr "미리보기(집계되지 않음)"

msgid "Code from stats4u.net"
msgstr "stats4u.net의 코드"

msgid "Paste your code"
msgstr "코드 붙여넣기"

msgid "Use a different counter or code"
msgstr "다른 카운터나 코드 사용"

msgid "Paste the HTML, BBCode or image address from stats4u.net - or just the counter number. Design, colors, size and everything else you set there come along."
msgstr "stats4u.net의 HTML, BBCode 또는 이미지 주소를 붙여넣거나 카운터 번호만 입력하세요. 디자인, 색상, 크기 등 그곳에서 설정한 모든 내용이 함께 적용됩니다."

msgid "Create a free counter on stats4u.net"
msgstr "stats4u.net에서 무료 카운터 만들기"

msgid "At the end, a button brings the code back here."
msgstr "마지막에 버튼을 누르면 코드가 이곳으로 돌아옵니다."

msgid "Appearance"
msgstr "모양"

msgid "Size"
msgstr "크기"

msgid "Sharp at any size for the modern designs. The classic pixel designs keep their original size."
msgstr "최신 디자인은 어떤 크기에서도 선명합니다. 클래식 픽셀 디자인은 원래 크기를 유지합니다."

msgid "Language of the counter"
msgstr "카운터 언어"

msgid "as set on stats4u.net"
msgstr "stats4u.net 설정대로"

msgid "the language of each page"
msgstr "각 페이지의 언어"

msgid "Dark mode"
msgstr "어두운 모드"

msgid "follow the device"
msgstr "기기 설정을 따름"

msgid "always light"
msgstr "항상 밝게"

msgid "always dark"
msgstr "항상 어둡게"

msgid "Count"
msgstr "집계 방식"

msgid "every page view"
msgstr "모든 페이지 조회"

msgid "unique visitors"
msgstr "순 방문자"

msgid "Link"
msgstr "링크"

msgid "link the counter to its public statistics page on stats4u.net"
msgstr "카운터를 stats4u.net의 공개 통계 페이지에 링크"

msgid "Off by default. Visitors who click the counter then see your statistics."
msgstr "기본값은 꺼짐입니다. 켜면 카운터를 클릭한 방문자가 내 통계를 볼 수 있습니다."

msgid "Placement"
msgstr "배치"

msgid "Where to show it"
msgstr "표시 위치"

msgid "below your theme's footer (recommended)"
msgstr "테마 바닥글 아래(권장)"

msgid "inside your theme's footer, at its end"
msgstr "테마 바닥글 안의 맨 끝"

msgid "at the very end of the page"
msgstr "페이지 맨 끝"

msgid "below the content of posts and pages"
msgstr "글과 페이지 본문 아래"

msgid "fixed in the bottom right corner"
msgstr "오른쪽 아래 모서리에 고정"

msgid "fixed in the bottom left corner"
msgstr "왼쪽 아래 모서리에 고정"

msgid "nowhere automatically - I place it myself"
msgstr "자동으로 표시하지 않음(직접 배치)"

msgid "To place it yourself, use the block \"Stats4U counter\" or the shortcode [stats4u] - for example in a footer widget."
msgstr "직접 배치하려면 “Stats4U 카운터” 블록이나 숏코드 [stats4u]를 사용하세요. 예를 들어 바닥글 위젯에 넣을 수 있습니다."

msgid "Alignment"
msgstr "정렬"

msgid "left"
msgstr "왼쪽"

msgid "center"
msgstr "가운데"

msgid "right"
msgstr "오른쪽"

msgid "On which pages"
msgstr "표시할 페이지"

msgid "on all pages"
msgstr "모든 페이지"

msgid "only on the front page"
msgstr "홈페이지에서만"

msgid "only on single posts and pages"
msgstr "개별 글과 페이지에서만"

msgid "Consent"
msgstr "동의"

msgid "Load the counter"
msgstr "카운터 로드"

msgid "right away - I use no consent tool"
msgstr "즉시(동의 관리 도구 사용 안 함)"

msgid "Found on this site"
msgstr "이 사이트에서 발견됨"

msgid "after consent in %s"
msgstr "%s에서 동의한 후"

msgid "Consent tools"
msgstr "동의 관리 도구"

msgid "after consent in another tool - enter its attributes"
msgstr "다른 도구에서 동의한 후(속성 입력)"

msgid "With a consent tool, visitors who decline are not counted - your numbers will be lower."
msgstr "동의 관리 도구를 사용하면 동의를 거부한 방문자는 집계되지 않으므로 수치가 낮아집니다."

msgid "Category or service"
msgstr "카테고리 또는 서비스"

msgid "Leave empty for the usual one of your tool. If your tool works with named services, enter the name you gave Stats4U there."
msgstr "비워 두면 도구의 기본 카테고리를 사용합니다. 도구가 서비스 이름으로 관리하는 경우 그곳에서 Stats4U에 지정한 이름을 입력하세요."

msgid "Attributes"
msgstr "속성"

msgid "What your consent tool wants on a script it should only run after consent. Allowed: type, class and data-* attributes."
msgstr "동의 후에만 실행해야 하는 스크립트에 동의 관리 도구가 요구하는 속성입니다. 허용: type, class 및 data-* 속성."

msgid "A paragraph for your privacy policy is at %s."
msgstr "개인정보 처리방침에 넣을 문단은 %s에 있습니다."

msgid "Puts a Stats4U visitor counter on your site. Paste the code from stats4u.net, choose where it appears and, if you use a consent banner, let it decide when the counter loads."
msgstr "사이트에 Stats4U 방문자 카운터를 추가합니다. stats4u.net의 코드를 붙여넣고 표시 위치를 선택하세요. 동의 배너를 사용한다면 카운터를 로드할 시점을 배너가 결정하게 할 수 있습니다."

msgid "Your code"
msgstr "내 코드"

#. translators: %s: a line of PHP code
#, php-format
msgid "In a theme template (PHP): %s"
msgstr "테마 템플릿 파일(PHP): %s"

msgid "Feedback"
msgstr "피드백"

msgid "Missing something, found a bug, or have an idea? Write to us - every message is read."
msgstr "부족한 점이나 버그를 발견하셨거나 아이디어가 있으신가요? 알려 주세요. 모든 메시지를 읽습니다."

msgid "Your message"
msgstr "메시지"

msgid "Email for an answer (optional)"
msgstr "답변받을 이메일(선택)"

msgid "Also send my site address and counter number"
msgstr "사이트 주소와 카운터 번호도 함께 보내기"

msgid "Send feedback"
msgstr "피드백 보내기"

msgid "Thank you - your message has arrived."
msgstr "감사합니다. 메시지가 도착했습니다."

msgid "Please write a little more - at least a few words."
msgstr "조금 더 써 주세요. 몇 단어 이상이 필요합니다."

msgid "This email address does not look right."
msgstr "이메일 주소가 올바르지 않은 것 같습니다."

msgid "Too many messages from here - please try again in an hour."
msgstr "이곳에서 보낸 메시지가 너무 많습니다. 1시간 후에 다시 시도해 주세요."

msgid "stats4u.net could not be reached. Please try again later."
msgstr "stats4u.net에 연결할 수 없습니다. 잠시 후 다시 시도해 주세요."

#. translators: %s: link "Privacy policy" to stats4u.net
#, php-format
msgid "Your browser sends the message to stats4u.net, together with the plugin version and the language of this page. %s"
msgstr "브라우저가 메시지를 플러그인 버전 및 이 페이지의 언어와 함께 stats4u.net으로 보냅니다. %s"

msgid "Privacy policy"
msgstr "개인정보 처리방침"

msgid "Free hit counters and visitor stats for websites"
msgstr "무료 홈페이지 방문자 카운터"

msgid "Simple, lightweight and secure analytics."
msgstr "가볍고 안전한, 간단한 통계."

msgid "Restart wizard"
msgstr "마법사 다시 시작"

msgid "Custom configuration"
msgstr "사용자 지정 설정"

msgid "Done"
msgstr "완료"

msgid "Settings sections"
msgstr "설정 섹션"

#. translators: 1: counter number, 2: design number
#, php-format
msgid "Received from stats4u.net: counter %1$s, design %2$s. Continue with \"Next\"."
msgstr "stats4u.net에서 받았습니다: 카운터 %1$s, 디자인 %2$s. “다음”을 눌러 계속하세요."

msgid "Request a new counter number"
msgstr "새 카운터 번호 받기"

msgid "Back"
msgstr "이전"

msgid "Next"
msgstr "다음"

msgid "Save and finish"
msgstr "저장하고 완료"

msgid "Save to put the counter on your site. You can change everything later - or run this wizard again."
msgstr "저장하면 카운터가 사이트에 표시됩니다. 나중에 모두 바꿀 수 있고, 이 마법사를 다시 실행할 수도 있습니다."

msgid "How do you want to set up your counter?"
msgstr "카운터를 어떻게 설정하시겠어요?"

msgid "Recommended"
msgstr "추천"

msgid "Wizard"
msgstr "마법사"

msgid "Step by step, with a live preview - about two minutes."
msgstr "실시간 미리보기와 함께 단계별로 – 약 2분이면 됩니다."

msgid "Start the wizard"
msgstr "마법사 시작"

msgid "All settings on one page, sorted in a menu."
msgstr "모든 설정을 한 페이지에서 메뉴별로 정리해 보여 줍니다."

msgid "Open the settings"
msgstr "설정 열기"

#. translators: 1: number of the current step, 2: number of steps
#, php-format
msgid "Step %1$d of %2$d"
msgstr "%2$d단계 중 %1$d단계"

msgid "Choose or create a counter first."
msgstr "먼저 카운터를 선택하거나 만드세요."

#. translators: %s: the new counter number
#, php-format
msgid "New counter number %s - it is used as soon as you save."
msgstr "새 카운터 번호 %s – 저장하면 바로 사용됩니다."

msgid "Too many new numbers from here - please try again in an hour."
msgstr "이곳에서 새 번호를 너무 많이 요청했습니다. 1시간 후에 다시 시도해 주세요."
